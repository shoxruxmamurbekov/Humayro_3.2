# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set in your hosting provider (Netlify environment variables). Never commit real keys.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Primary & Fallback AI Provider ('gemini' | 'groq' | 'openrouter' | 'rss-fallback for fallback only)
AI_PROVIDER="gemini"
# GROQ_API_KEY=""
# OPENROUTER_API_KEY=""
# FALLBACK_AI_PROVIDER="groq"

# Optional model overrides. The Admin AI Provider Manager can also store model IDs.
# AI_MODEL_GEMINI="gemini-3.1-flash-lite"
# AI_MODEL_GROQ="llama-3.3-70b-versatile"
# AI_MODEL_OPENROUTER="openai/gpt-4o-mini"

# Required only if API keys are saved through the Admin AI Provider Manager UI.
# Generate a strong random value, e.g.: openssl rand -hex 32
# Keep this value private and stable; changing it makes previously saved provider keys unreadable.
AI_SETTINGS_ENCRYPTION_KEY="replace-with-a-random-secret-of-at-least-32-characters"

# Admin dashboard secret (required). Send it as the x-admin-token header to /api/admin/metrics.
ADMIN_SECRET="your-strong-random-admin-secret-token"

# Optional Cloud Database & Auth (Supabase Free Tier)
# If left empty, Humayro_3.2 uses high-speed browser-local persistence
# VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY=""

# APP_URL: public URL of the deployed site (optional).
APP_URL="MY_APP_URL"
PORT="3000"

# YouTube Data API v3 key (mintaqa videolari uchun). Bo'lmasa qidiruv havolasi ko'rsatiladi.
YOUTUBE_API_KEY=
